# Copiá este archivo como .env y ajustá los valores.

# Ubicación de la base SQLite. Las rutas relativas son relativas a la carpeta prisma/.
# Recomendado: una carpeta local que NO esté sincronizada por OneDrive/Dropbox/Drive,
# porque sincronizar un SQLite en uso puede corromperlo. Ejemplo en Windows:
# DATABASE_URL="file:C:/Users/USUARIO/AppData/Local/EtiquetasFarmacia/farmacia.db"
DATABASE_URL="file:./farmacia.db"

# Servidor. 127.0.0.1 = solo accesible desde esta PC.
HOST=127.0.0.1
PORT=3000

# Copias de seguridad. Ruta relativa a apps/server. Una carpeta sincronizada en la nube
# es buena idea acá: las copias ya no se modifican después de creadas.
BACKUP_DIR=../../backups
BACKUP_KEEP=30
